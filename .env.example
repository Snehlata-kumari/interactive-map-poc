# "local" = data/project.json only; "api" = the BFF (/api/project + /api/units)
NEXT_PUBLIC_CONTENT_SOURCE=local

# BFF upstreams (server-only). Unset = the mocks in data/mock-*.json.
# CONTENT_API_URL=https://cms.example.com/map-content
# CONTENT_API_TOKEN=
# UNITS_API_URL=https://sales.example.com/units
# UNITS_API_TOKEN=

# Hosts next/image may load content images from (comma-separated).
# IMAGE_HOSTS=images.ctfassets.net

# SVG placement tool ("Align SVG" switch) in production builds; always on in dev.
# NEXT_PUBLIC_SVG_PLACEMENT=1
